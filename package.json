{
  "name": "gottago",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/mobile",
    "apps/api"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace @gottago/mobile",
    "dev:api": "npm run dev --workspace @gottago/api",
    "lint": "npm run lint --workspaces --if-present",
    "verify:stack": "bash scripts/verify-local-stack.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "typescript-eslint": "^8.57.1"
  }
}
